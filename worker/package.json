    "@vitest/runner": "~4.1.0",
    "@vitest/snapshot": "~4.1.0",
    "typescript": "~6.0.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.137.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260921.1": true
  }
